+#[cfg(any(test, target_arch = "wasm32"))]
+fn locale_tags_from_browser(search: &str, navigator: impl IntoIterator<Item = String>) -> Vec<String> {
+    if let Some(tag) = query_lang(search) {
+        return bounded_tags([tag]);
+    }
+    bounded_tags(navigator)
+}
