+    let search = search.strip_prefix('?').unwrap_or(search);
+    if search.is_empty() {
+        return None;
+    }
+    for pair in search.split('&') {
+        let (key, value) = pair.split_once('=').unwrap_or((pair, ""));
+        if !key.eq_ignore_ascii_case("lang") {
+            continue;
+        }
+        let trimmed = percent_decode(value).trim().to_owned();
+        if !trimmed.is_empty() {
+            return Some(trimmed);
+        }
+    }
