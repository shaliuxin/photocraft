+/// rather than handing all host RAM (32 GiB on a 2-in-1) to admission: ordinary photos need
+/// far less, while a multi-gigapixel document still gets a clear refusal instead of an OOM kill.
+#[cfg(any(target_env = "ohos", test))]
+const OHOS_APP_MEMORY_CAP: u64 = 2 << 30;
+
+/// [`current`] on OpenHarmony: `/proc/meminfo` is readable inside an app sandbox, unlike cgroup.
+#[cfg(target_env = "ohos")]
+fn ohos_current() -> SystemMemory {
+    match std::fs::read_to_string("/proc/meminfo") {
+        Ok(info) => ohos_snapshot_from(&info),
+        Err(_) => SystemMemory::UNKNOWN,
+    }
