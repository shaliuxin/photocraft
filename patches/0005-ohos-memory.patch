+/// A `/proc/meminfo` field in bytes.
+#[cfg(any(target_env = "ohos", test))]
+fn meminfo_field(info: &str, field: &str) -> Option<u64> {
+    let kb: u64 = info.lines().find_map(|l| l.strip_prefix(field))?.trim().trim_end_matches("kB").trim().parse().ok()?;
+    kb.checked_mul(1024)
