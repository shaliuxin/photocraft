+/// Builds an OHOS snapshot from `/proc/meminfo` text. Platform-independent so the policy is
+/// testable on every build host. A missing `MemAvailable` is unknown memory, never zero.
+#[cfg(any(target_env = "ohos", test))]
+fn ohos_snapshot_from(info: &str) -> SystemMemory {
+    let Some(ram) = meminfo_field(info, "MemAvailable:") else {
+        return SystemMemory::UNKNOWN;
+    };
+    SystemMemory {
+        available_ram: Some(ram.min(OHOS_APP_MEMORY_CAP)),
+        swap_free: Some(0),
+        commit_headroom: None,
+        constraint_unreadable: false,
+    }
+}
