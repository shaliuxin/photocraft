+#[test]
+fn picked_names_lose_their_folders() {
+    assert_eq!(safe_name("/storage/Users/a/b.wasm"), "b.wasm");
+    assert_eq!(safe_name("..\\x?.icc"), "x_.icc");
+    assert_eq!(safe_name(".."), "file");
