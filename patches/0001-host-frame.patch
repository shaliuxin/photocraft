+[features]
+default = ["eframe-host", "self-update"]
+# The desktop window: eframe owns the event loop, the surface and the frame each pass is handed.
+# A platform shell that owns its own window (HarmonyOS' ArkUI/XComponent, a scripted host) turns
+# this off and drives `PhotocraftApp::host_input` / `host_logic` / `host_ui` itself.
+eframe-host = ["dep:eframe"]
+# Check for and install a new release (desktop and web). A package that the store updates turns
+# this off: the app has nowhere to write a new build.
+self-update = ["dep:craft-update"]
+
